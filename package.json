{
  "name": "gesto-em-cena",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo desktop local para reconhecer gestos diante da webcam.",
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/copy-assets.mjs && vite build --base=./",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide": "^0.468.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.gestoemcena.desktop",
    "productName": "Gesto em Cena",
    "files": [
      "main.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
